{% extends '@MauticCore/Default/content.html.twig' %}

{% block headerTitle %}{{ 'mautic.bulkmailer.page.title'|trans }}{% endblock %}

{% block content %}
<div class="panel panel-default">
    <div class="panel-body">
        <p class="text-muted">{{ 'mautic.bulkmailer.page.intro'|trans }}</p>

        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
            {{ form_row(form.email) }}
            {% if securityIsGranted('email:emails:create') %}
                <p class="help-block">
                    <a href="{{ path('mautic_email_action', {'objectAction': 'new'}) }}" target="_blank" rel="noopener">
                        <i class="ri-add-line"></i> {{ 'mautic.bulkmailer.form.template.create_new'|trans }}
                    </a>
                </p>
            {% endif %}
            {{ form_row(form.file) }}
            <p class="help-block">{{ 'mautic.bulkmailer.form.file.hint'|trans }}</p>
            {{ form_row(form.skipAlreadySent) }}

            <div class="form-group" style="margin-top: 1rem;">
                <button type="submit" class="btn btn-primary">
                    <i class="ri-mail-send-line"></i>
                    {{ 'mautic.bulkmailer.form.submit'|trans }}
                </button>
            </div>
        {{ form_end(form) }}

        <p class="help-block">{{ 'mautic.bulkmailer.page.note'|trans }}</p>
    </div>
</div>
{% endblock %}
